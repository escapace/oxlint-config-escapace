{
  "name": "oxlint-config-escapace",
  "description": "Oxlint-first lint baseline with a bundled ESLint residual for YAML, TOML, JSON and Vue templates, behind one command.",
  "version": "0.0.0",
  "author": {
    "name": "escapace",
    "email": "opensource@escapace.com"
  },
  "bin": {
    "esclint": "./lib/node/esclint.js"
  },
  "bugs": "https://github.com/escapace/oxlint-config-escapace/issues",
  "devDependencies": {
    "@astrojs/compiler-rs": "0.5.2",
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@escapace/pnpm-pack": "0.9.2",
    "@escapace/syncpack-configuration": "0.3.0",
    "@eslint/js": "10.0.1",
    "@ls-lint/ls-lint": "2.3.2",
    "@microsoft/tsdoc": "0.17.1",
    "@microsoft/tsdoc-config": "0.18.3",
    "@stylistic/eslint-plugin": "5.10.0",
    "@types/node": "24.19.2",
    "@types/semver": "7.8.0",
    "@typescript-eslint/eslint-plugin": "8.72.1",
    "@typescript-eslint/parser": "8.72.1",
    "@typescript-eslint/rule-tester": "8.72.1",
    "@typescript-eslint/scope-manager": "8.72.1",
    "@typescript-eslint/utils": "8.72.1",
    "@vitest/coverage-v8": "5.0.5",
    "ajv": "8.20.0",
    "astro-eslint-parser": "3.2.0",
    "es-toolkit": "1.53.1",
    "eslint": "10.14.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-astro": "3.2.1",
    "eslint-plugin-baseline-js": "0.7.7",
    "eslint-plugin-de-morgan": "2.3.0",
    "eslint-plugin-depend": "1.5.0",
    "eslint-plugin-jsonc": "3.4.2",
    "eslint-plugin-jsx-a11y-x": "0.2.0",
    "eslint-plugin-math": "0.13.1",
    "eslint-plugin-perfectionist": "5.13.0",
    "eslint-plugin-regexp": "3.3.3",
    "eslint-plugin-toml": "1.5.0",
    "eslint-plugin-unicorn": "79.0.0",
    "eslint-plugin-vue": "10.12.0",
    "eslint-plugin-vuejs-accessibility": "2.6.3",
    "eslint-plugin-yml": "3.9.0",
    "fallow": "3.38.1",
    "ignore": "7.0.14",
    "json-schema-to-typescript": "16.0.0",
    "jsonc-eslint-parser": "3.3.0",
    "lefthook": "2.2.1",
    "oxfmt": "0.75.0",
    "oxlint": "1.90.0",
    "oxlint-config-escapace": "link:",
    "oxlint-tsgolint": "7.0.2005",
    "rolldown": "1.2.16",
    "semver": "7.8.5",
    "syncpack": "15.3.3",
    "trigram-utils": "2.0.1",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.0.5",
    "vue-eslint-parser": "10.4.1"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "onFail": "warn",
      "version": "^12.15.0"
    },
    "runtime": {
      "name": "node",
      "onFail": "warn",
      "version": "^24.16.0"
    }
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "import": "./lib/node/index.js"
    },
    "./eslint": {
      "types": "./lib/types/eslint.d.ts",
      "import": "./lib/node/eslint.js"
    }
  },
  "files": [
    "lib/node",
    "lib/types"
  ],
  "homepage": "https://github.com/escapace/oxlint-config-escapace#readme",
  "license": "MPL-2.0",
  "peerDependencies": {
    "@astrojs/compiler-rs": "^0.4.0 || ^0.5.0",
    "eslint": "^10.0.0",
    "oxlint": "^1.90.0",
    "oxlint-tsgolint": "^7.0.2005"
  },
  "peerDependenciesMeta": {
    "@astrojs/compiler-rs": {
      "optional": true
    },
    "eslint": {
      "optional": true
    },
    "oxlint": {
      "optional": true
    },
    "oxlint-tsgolint": {
      "optional": true
    }
  },
  "private": false,
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": "escapace/oxlint-config-escapace",
  "scripts": {
    "build": "pnpm run codegen && tsx scripts/build.ts",
    "codegen": "tsx scripts/codegen.ts",
    "fallow": "fallow dead-code --fail-on-issues",
    "format": "syncpack format && node lib/node/esclint.js --fix && oxfmt",
    "lint": "ls-lint --config .ls-lint.yaml && pnpm run fallow && node lib/node/esclint.js",
    "ls-lint": "ls-lint --config .ls-lint.yaml",
    "pack": "pnpm-pack package --pack-destination lib",
    "prepare": "lefthook install",
    "syncpack": "syncpack fix && syncpack format",
    "test": "vitest --no-watch --coverage --coverage.reporter=text-summary",
    "typecheck": "tsc --noEmit",
    "update": "ncu --cooldown 7 -p pnpm -u --peer --dep dev,peer,prod,optional && pnpm run syncpack"
  },
  "sideEffects": false,
  "type": "module",
  "types": "./lib/types/index.d.ts"
}
